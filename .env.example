# Cynbit DealEngine Environment Configuration

# Application Settings
ENVIRONMENT=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# LLM Provider Configuration (Optional - Falls back to High-Fidelity Demo Mode if blank)
# Recommended free/low-cost options:
# 1. Groq (Free tier with fast Llama-3.3-70b): https://console.groq.com/
# 2. OpenAI (GPT-4o-mini): https://platform.openai.com/
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=llama-3.3-70b-versatile

# RAG & Embeddings
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# Human Approval & Security
REQUIRE_HUMAN_APPROVAL_FOR_DISPATCH=true
MAX_DAILY_AUTO_DISPATCH=0
ADMIN_APPROVAL_TOKEN=cynbit_secure_architect_key_2026
